# ComplianceIQ Core Service — environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be
# committed; this file carries names and shapes only, never values.

# --- Database -------------------------------------------------------
COMPLIANCEIQ_DB_HOST=localhost
COMPLIANCEIQ_DB_PORT=5432
COMPLIANCEIQ_DB_NAME=complianceiq
COMPLIANCEIQ_DB_USER=complianceiq
COMPLIANCEIQ_DB_PASSWORD=
COMPLIANCEIQ_DB_POOL_SIZE=5

# --- JWT ------------------------------------------------------------
# PKCS#8 PEM private key used to SIGN tokens. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out core-signing.pem
#
# There is deliberately no default and no generate-at-boot fallback: a
# key created at startup would invalidate every outstanding token on
# each restart and would differ between replicas, so two instances
# behind a load balancer would reject each other's tokens.
#
# In production this belongs in a secret manager and should be mounted,
# not passed as a plain environment variable.
JWT_PRIVATE_KEY=
JWT_ISSUER=complianceiq-core
JWT_AUDIENCE=complianceiq
JWT_KEY_ID=core-1

# --- API ------------------------------------------------------------
# Comma-separated browser origins allowed by CORS. EMPTY MEANS NO
# CROSS-ORIGIN ACCESS, which is the correct default — never use "*"
# together with credentials.
CORS_ORIGINS=
LOG_LEVEL=INFO

# --- Cloud credentials ----------------------------------------------
# NOT set here. AWS and Azure authentication use their SDKs' standard
# credential chains (instance role, workload identity, CLI profile).
# Long-lived cloud keys in environment variables are the single most
# common way a CSPM platform becomes the breach it was bought to prevent.
